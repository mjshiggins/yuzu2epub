{
  "manifest_version": 3,
  "name": "Yuzu to EPUB",
  "version": "0.1.0",
  "description": "Assemble a complete, Kindle-ready EPUB from a Yuzu textbook you own, with a nested Part/Chapter table of contents, cover art and images.",
  "permissions": [
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "*://reader.yuzu.com/*",
    "*://jigsaw.yuzu.com/*",
    "*://covers.vitalsource.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Yuzu to EPUB",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}